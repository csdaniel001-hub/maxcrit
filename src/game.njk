---
layout: base.njk
pagination: { data: games, size: 1, alias: slug }
permalink: "/games/{{ slug }}.html"
activeNav: games
eleventyComputed:
  title: "{{ games[slug].name }}: news, patch notes and guides"
  shareImage: "{{ collections.everything | gamePic(slug) }}"
  summary: "All our {{ games[slug].name }} coverage in one place: news from {{ games[slug].publisher }}, patch trackers and guides, with official store links."
---
{% from "macros.njk" import listing, getgame with context %}
{% set g = games[slug] %}
{% set tabs %}<div style="max-width:520px;margin-top:18px">{{ getgame(slug, pre) }}</div>{% endset %}
{{ listing(collections.everything | byGame(slug), pre, '<a href="' + ('/games.html' | rel) + '">Games A–Z</a>', g.name, g.publisher + (' · ' + g.status if g.status else ''), 'Pages', tabs) }}
