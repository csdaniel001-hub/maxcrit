---
layout: base.njk
permalink: /news.html
activeNav: news
bodyClass: "gz-home"
title: Latest mobile gaming news
summary: Mobile gaming news from official sources only, newest first. Updates, betas, launches and balance changes for iOS and Android games.
---
{% from "macros.njk" import allrow with context %}
{% set all = collections.news %}
<header class="gz-phead">
<p class="gz-crumbs mono"><a href="{{ '/index.html' | rel }}">Home</a> / News</p>
<h1>Latest news</h1>
<p class="gz-phead-d">Mobile gaming news from official sources only, newest first. Dates in UTC.</p>
<dl class="gz-spec mono"><div><dt>Stories</dt><dd>{{ all.length }}</dd></div>{% if all.length %}<div><dt>Last updated</dt><dd>{{ all[0].data.published_at | longDate }}</dd></div>{% endif %}</dl>
</header>
{% include "gtabs.njk" %}
<section class="hz-all" aria-label="All news" style="margin-top:22px">
<header class="hz-sh"><div class="hz-tabs"><button type="button" class="on" data-f="all">All</button>{% for g in genreNav %}{% if (all | byGenre(g.slug)).length %}<button type="button" data-f="{{ g.slug }}">{{ g.name }}</button>{% endif %}{% endfor %}</div><span class="hz-allc mono" id="gzAllC">{{ all.length }} stories</span></header>
<ol id="gzAll">{% for n in all %}{{ allrow(n, pre) }}{% endfor %}</ol>
<div class="hz-all-f"><button type="button" class="hz-moreb" id="gzMoreB" hidden>Load more</button></div>
</section>
<script>
(function(){var tabs=document.querySelectorAll('.hz-tabs button'),al=[].slice.call(document.querySelectorAll('#gzAll li')),mb=document.getElementById('gzMoreB'),ac=document.getElementById('gzAllC'),flt='all',vis=15;
function paint(){var n=0,tot=0;al.forEach(function(li){var ok=flt==='all'||li.dataset.s===flt;if(ok)tot++;li.hidden=!(ok&&n<vis);if(ok&&n<vis)n++;});if(ac)ac.textContent=n+' / '+tot+' stories';if(mb)mb.hidden=n>=tot;}
tabs.forEach(function(b){b.addEventListener('click',function(){tabs.forEach(function(x){x.classList.toggle('on',x===b)});flt=b.dataset.f;vis=15;paint()})});
if(mb)mb.addEventListener('click',function(){vis+=15;paint()});paint();})();
</script>
