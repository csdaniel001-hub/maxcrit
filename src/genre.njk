---
layout: base.njk
pagination: { data: genreNav, size: 1, alias: g }
permalink: "/genre/{{ g.slug }}.html"
activeSection: genres
eleventyComputed:
  title: "{{ g.adj or g.name }} mobile games: news, patches and guides"
  seo_title: "{{ g.adj or g.name }} games: news, patches and guides"
  summary: "{{ g.desc }}"
  activeNav: "g-{{ g.slug }}"
  noindex: "{{ '' if (collections.everything | byGenre(g.slug)).length else 'yes' }}"
  shareImage: "{{ (collections.everything | byGenre(g.slug) | featured | first).data.image if (collections.everything | byGenre(g.slug) | featured).length else '' }}"
---
{% from "macros.njk" import listing with context %}
{% set tabs = "" %}
{{ listing(collections.everything | byGenre(g.slug), pre, 'Genre', g.name, g.desc, 'Pages', tabs, g.slug, g.art or '') }}
{% set gi = genreIntro[g.slug] %}{% if gi %}<section class="gz-box mc-gintro" aria-label="About {{ g.name }} on MaxCrit"><div class="gz-box-h"><h2>About {{ g.name }} on MaxCrit</h2></div>{% for p in (gi | trim).split("\n\n") %}<p>{{ p }}</p>{% endfor %}</section>{% endif %}
