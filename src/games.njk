</header>
<section class="gz-rovat gz-rovat-first"><div class="gz-cgrid">
{% for slug in gl | sort %}{% set g = games[slug] %}{% set items = collections.everything | byGame(slug) %}<a class="gz-tc" href="{{ ('/games/' + slug + '.html') | rel }}"><span class="gz-pic"><img src="{{ items[0].data.image | wsrc(480) | rel }}" alt="" width="480" height="270" loading="lazy" decoding="async"></span><b class="kx-tb">{% if not g.noicon %}<img class="kx-ico s" src="{{ ('/assets/img/icons/' + slug + '.webp') | rel }}" alt="" width="32" height="32" loading="lazy">{% endif %}{{ g.name }}</b><time class="mono">{{ g.publisher | upper }}</time></a>{% endfor %}
