{% from "macros.njk" import clock with context %}
<header class="gz-phead">
<p class="gz-crumbs mono"><a href="{{ '/index.html' | rel }}">Home</a> / Games</p>
<h1>Games A–Z</h1>
<p class="gz-phead-d">Every game we cover, with all of its news and hub pages on one page. Store links go to the official listings.</p>
{% set gl = [] %}{% for slug, g in games %}{% if (collections.everything | byGame(slug)).length %}{% set gl = (gl.push(slug), gl) %}{% endif %}{% endfor %}
<dl class="gz-spec mono"><div><dt>Games</dt><dd>{{ gl.length }}</dd></div></dl>
</header>
<section class="gz-rovat gz-rovat-first"><div class="gz-cgrid">
{% for slug in gl | sort %}{% set g = games[slug] %}{% set items = collections.everything | byGame(slug) %}<a class="gz-tc" href="{{ ('/games/' + slug + '.html') | rel }}"><span class="gz-pic"><img src="{{ items[0].data.image | rel }}" alt="" loading="lazy"></span><b>{{ g.name }}</b><time class="mono">{{ g.publisher | upper }} · {{ items.length }} {% if items.length == 1 %}PAGE{% else %}PAGES{% endif %}</time></a>{% endfor %}
</div></section>
