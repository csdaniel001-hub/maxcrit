---
layout: base.njk
pagination: { data: topicNav, size: 1, alias: t }
permalink: "/{{ t.slug }}.html"
eleventyComputed:
  title: "{{ t.name }}: news, banners and guides"
  summary: "{{ t.desc }}"
  activeNav: "t-{{ t.slug }}"
  noindex: "{{ '' if (collections.stories | byTopic(t.slug)).length else 'yes' }}"
  shareImage: "{{ (collections.stories | byTopic(t.slug) | featured | first).data.image if (collections.stories | byTopic(t.slug) | featured).length else '' }}"
---
{% from "macros.njk" import listing with context %}
{% set tabs = "" %}
{{ listing(collections.stories | byTopic(t.slug), pre, 'Section', t.name, t.desc, 'Pages', tabs, '') }}
