{%- from "logo.njk" import logo with context -%}
{%- macro mico(name) -%}<img class="kx-mico" src="{{ ('/assets/img/micons/' + name + '.webp') | rel }}" alt="" width="34" height="34" aria-hidden="true">{%- endmacro -%}
{%- set ogImg = image or shareImage or '/assets/img/share/maxcrit.jpg' -%}
{%- set ogTitle = (title or (site.name + ': ' + site.tagline)) | unent -%}
{%- set desc = (summary or site.description) | unent -%}
{%- set docTitle = ((seo_title or title) | unent) -%}
{%- set gaId = site.analytics.ga4 if (site.analytics.ga4 and site.analytics.ga4.startsWith('G-')) else '' -%}
{%- set cfTok = site.analytics.cloudflare if (site.analytics.cloudflare and not site.analytics.cloudflare.startsWith('[')) else '' -%}
<!DOCTYPE html>
<html lang="{{ site.lang }}" data-gz="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if docTitle %}{{ docTitle }} · {{ site.name }}{% else %}{{ site.name }}: {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ desc }}">
<meta name="robots" content="{% if noindex %}noindex, follow{% else %}index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1{% endif %}">
<meta name="theme-color" content="#0e0924">
<link rel="canonical" href="{{ site.url }}{{ page.url | replace('/index.html', '/') }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:type" content="{% if published_at %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ ogTitle }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="{{ site.url }}{{ page.url | replace('/index.html', '/') }}">
<meta property="og:image" content="{{ site.url }}{{ ogImg }}">
<meta property="og:image:width" content="{% if ogImg == '/assets/img/share/maxcrit.jpg' %}1200{% else %}1600{% endif %}">
<meta property="og:image:height" content="{% if ogImg == '/assets/img/share/maxcrit.jpg' %}630{% else %}900{% endif %}">
<meta property="og:image:alt" content="{{ image_alt or ogTitle }}">
{% if published_at %}<meta property="article:published_time" content="{{ published_at | isoDate }}">
<meta property="article:modified_time" content="{{ (updated_at or published_at) | isoDate }}">
{% for gs in genres or [] %}<meta property="article:section" content="{{ (genreNav | find('slug', gs)).name }}">{% endfor %}
{% for t in titles or [] %}{% if games[t] %}<meta property="article:tag" content="{{ games[t].name }}">{% endif %}{% endfor %}
{% endif %}<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle }}">
<meta name="twitter:description" content="{{ desc }}">
<meta name="twitter:image" content="{{ site.url }}{{ ogImg }}">
<link rel="icon" href="{{ '/assets/img/favicon.svg' | rel }}" type="image/svg+xml">
<link rel="preload" href="{{ '/assets/fonts/barlow-condensed-latin-700-normal.woff2' | rel }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ '/assets/fonts/barlow-latin-400-normal.woff2' | rel }}" as="font" type="font/woff2" crossorigin>
{% if lcp %}<link rel="preload" as="image" href="{{ lcp | rel }}" fetchpriority="high">
{% endif %}<link rel="stylesheet" href="{{ '/assets/css/site.css' | rel }}?v={{ site.build }}">
{% if gaId %}<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied'});</script>
{% endif %}<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="{{ '/feed.xml' | rel }}">
{% if page.url == '/' or page.url == '/index.html' %}<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"{{ site.url }}/#org","name":"{{ site.name }}","url":"{{ site.url }}/","logo":{"@type":"ImageObject","url":"{{ site.url }}/assets/img/share/logo.png","width":512,"height":512},"email":"{{ site.email }}","description":{{ site.description | jsonify | safe }}},{"@type":"WebSite","@id":"{{ site.url }}/#site","name":"{{ site.name }}","url":"{{ site.url }}/","inLanguage":"en","publisher":{"@id":"{{ site.url }}/#org"},"potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"{{ site.url }}/search.html?q={search_term_string}"},"query-input":"required name=search_term_string"}}]}</script>
{% endif %}</head>
<body class="{{ bodyClass or 'gz-home' }}">
<a class="gz-skip" href="#content">Skip to content</a>

<input type="checkbox" id="gzMenu" class="gz-mchk" aria-label="Open or close the menu">
<header class="gz-head">
<div class="gz-head-in">
<a class="gz-logo" href="{{ '/index.html' | rel }}" aria-label="{{ site.name }} home">{{ logo(34) }}</a>
<nav class="gz-hot kx-apps" aria-label="Popular games">{% for slug in site.hot %}{% set g = games[slug] %}<a href="{{ ('/games/' + slug + '.html') | rel }}"><img src="{{ ('/assets/img/icons/' + slug + '.webp') | rel }}" alt="" width="32" height="32"><span>{{ g.name }}</span></a>{% endfor %}</nav>
<form class="gz-search" action="{{ '/search.html' | rel }}" role="search"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg><label><span class="gz-sr">Search</span><input type="search" name="q" placeholder="Search…"></label></form>
<a class="gz-ibtn gz-rss" href="{{ '/feed.xml' | rel }}" aria-label="RSS"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 19h.01 M5 12a7 7 0 0 1 7 7 M5 5a14 14 0 0 1 14 14"/></svg></a>
<label class="gz-ibtn gz-menu" for="gzMenu"><span class="gz-sr">Menu</span><span></span><span></span></label>
</div>
</header>

<div class="gz-frame">
<aside class="gz-side" aria-label="Side menu">
<form class="gz-side-search" action="{{ '/search.html' | rel }}" role="search"><label><span class="gz-sr">Search</span><input type="search" name="q" placeholder="Search news, games and guides"></label></form>
<nav>
<a class="{% if page.url == '/' or page.url == '/index.html' %}on{% endif %}" href="{{ '/index.html' | rel }}">{{ mico('home') }}Home</a>
<a class="{% if activeNav == 'news' %}on{% endif %}" href="{{ '/news.html' | rel }}">{{ mico('news') }}Latest news</a>
<a class="{% if activeNav == 'games' %}on{% endif %}" href="{{ '/games.html' | rel }}">{{ mico('games') }}Games A–Z</a>
{% for t in topicNav %}<a class="topic{% if activeNav == 't-' + t.slug %} on{% endif %}" href="{{ ('/' + t.slug + '.html') | rel }}">{{ mico(t.mico) }}{{ t.name }}</a>
{% endfor %}
<details class="gz-grp" open>
<summary>{{ mico('hub') }}Player Hub<i aria-hidden="true"></i></summary>
<a class="sub{% if activeNav == 'hub' %} on{% endif %}" href="{{ '/hub.html' | rel }}"><span class="mc-si">{{ mico('star') }}</span><span class="mc-st">All hub pages</span></a>
{% for h in hubTypes %}{% set hc = (collections.hub | byHubType(h.slug)).length %}{% if hc %}<a class="sub{% if activeNav == 'h-' + h.slug %} on{% endif %}" href="{{ ('/hub/' + h.slug + '.html') | rel }}"><span class="mc-si">{{ mico(h.mico) }}</span><span class="mc-st">{{ h.name }}</span></a>
{% endif %}{% endfor %}
</details>
<details class="gz-grp" open>
<summary>{{ mico('mobile') }}Genres<i aria-hidden="true"></i></summary>
{% for g in genreNav %}{% set gc = (collections.everything | byGenre(g.slug)).length %}{% if gc %}<a class="sub{% if activeNav == 'g-' + g.slug %} on{% endif %}" href="{{ ('/genre/' + g.slug + '.html') | rel }}"><span class="mc-si">{{ mico(g.slug) }}</span><span class="mc-st">{{ g.name }}</span></a>
{% endif %}{% endfor %}
</details>
</nav>
</aside>
<div class="gz-col">
<div class="gz-tick"><span class="gz-tick-l mx-tl"><img class="kx-gem" src="{{ '/assets/img/ui/el-p05.webp' | rel }}" alt="" width="22" height="22" aria-hidden="true">Latest</span>
<div class="gz-marq" aria-label="Latest stories"><div class="gz-marq-in">{% for rep in [0,1] %}<span{% if rep %} aria-hidden="true"{% endif %}>{% for n in collections.everything | limit(8) %}<a href="{{ n.url | rel }}"{% if rep %} tabindex="-1"{% endif %}><b>{{ (n.data.updated_at or n.data.published_at) | shortDate }}</b>{{ n.data.title }}</a>{% endfor %}</span>{% endfor %}</div></div>
</div>
<main id="content" class="gz-main">
{{ content | safe }}
</main>
</div>
</div>

<footer class="gz-foot">
<div class="gz-foot-in">
<div class="gz-foot-brand">{{ logo(44) }}<p>{{ site.tagline }}.</p></div>
<nav aria-label="Sections"><h2 class="mono">Sections</h2><a href="{{ '/news.html' | rel }}">Latest news</a>{% for t in topicNav %}<a href="{{ ('/' + t.slug + '.html') | rel }}">{{ t.name }}</a>{% endfor %}<a href="{{ '/games.html' | rel }}">Games A–Z</a></nav>
<nav aria-label="Player Hub"><h2 class="mono">Player Hub</h2><a href="{{ '/hub.html' | rel }}">All hub pages</a>{% for h in hubTypes %}{% if (collections.hub | byHubType(h.slug)).length %}<a href="{{ ('/hub/' + h.slug + '.html') | rel }}">{{ h.name }}</a>{% endif %}{% endfor %}</nav>
<nav aria-label="About"><h2 class="mono">About</h2><a href="{{ '/about.html' | rel }}">About</a><a href="{{ '/contact.html' | rel }}">Contact</a><a href="{{ '/feed.xml' | rel }}">RSS</a></nav>
<nav aria-label="Legal"><h2 class="mono">Legal</h2><a href="{{ '/privacy.html' | rel }}">Privacy policy</a><a href="{{ '/cookies.html' | rel }}">Cookie policy</a><a href="{{ '/terms.html' | rel }}">Terms of use</a><button type="button" class="kx-cookie-open gz-foot-btn">Cookie settings</button></nav>
</div>
<div class="gz-foot-bot mono"><span>© 2026 {{ site.name | upper }}</span><span>Images are official press and store material from their rights holders.</span></div>
</footer>
{% set cs = site.consent %}<div class="kx-consent" id="kxConsent" role="dialog" aria-modal="false" aria-labelledby="kxcT" hidden data-auto="{{ 'y' if (cs.analytics or cs.ads) else '' }}"><div class="nf"><div class="nf-in">
<p class="kx-cc-t" id="kxcT">Cookie settings</p>
{% if cs.analytics or cs.ads %}<p>We would like to use the optional services below. They only run if you agree, and the site works the same either way. Details in the <a href="{{ '/cookies.html' | rel }}">Cookie policy</a>.</p>
<label class="kx-cc-row"><input type="checkbox" checked disabled><span><b>Strictly necessary</b><small>Remembers this choice. Always on.</small></span></label>
{% if cs.analytics %}<label class="kx-cc-row"><input type="checkbox" data-cat="analytics"><span><b>Analytics: {{ cs.analytics.name }}</b><small>Helps us {{ cs.analytics.purpose }}.</small></span></label>{% endif %}
{% if cs.ads %}<label class="kx-cc-row"><input type="checkbox" data-cat="ads"><span><b>Advertising: {{ cs.ads.name }}</b><small>Used to {{ cs.ads.purpose }}.</small></span></label>{% endif %}
<div class="kx-cc-btns"><button type="button" class="kx-mbtn" data-cc="reject">Reject all</button><button type="button" class="kx-mbtn" data-cc="save">Save choices</button><button type="button" class="kx-mbtn" data-cc="accept">Accept all</button></div>
{% else %}<p>MaxCrit uses no analytics, advertising or tracking cookies, so there is nothing to switch on or off. Nothing is stored in your browser. If that ever changes, we will ask here first. More in the <a href="{{ '/cookies.html' | rel }}">Cookie policy</a>.</p>
<div class="kx-cc-btns"><button type="button" class="kx-mbtn pri" data-cc="close">Got it</button></div>{% endif %}
</div></div></div>
<button class="kx-top" type="button" aria-label="Back to top"><img src="{{ '/assets/img/ui/cat-pink.webp' | rel }}" alt="" width="40" height="40"><span>TOP</span></button>
<script src="{{ '/assets/js/site.js' | rel }}?v={{ site.build }}" defer></script>
{% if gaId %}<script type="text/plain" data-consent="analytics" async src="https://www.googletagmanager.com/gtag/js?id={{ gaId }}"></script>
<script type="text/plain" data-consent="analytics">gtag('js',new Date());gtag('config','{{ gaId }}');</script>
{% endif %}{% if cfTok %}<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"{{ cfTok }}"}'></script>
{% endif %}{% block scripts %}{% endblock %}
</body>
</html>
