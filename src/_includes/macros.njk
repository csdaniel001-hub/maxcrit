{% macro moment(img, full, title, text, links) %}<div class="kx-moment"><img class="kx-cat{% if full %} kx-full{% endif %}" src="{{ ('/assets/img/chars/' + img + '.webp') | rel }}" alt="" width="{{ chars[img][0] }}" height="{{ chars[img][1] }}" loading="lazy"><div class="kx-mtx"><p class="kx-mt">{{ title }}</p><p>{{ text }}</p><div class="kx-mlinks">{% for l in links %}<a class="kx-mbtn{% if loop.first %} pri{% endif %}" href="{{ l[1] | rel }}">{{ l[0] }}</a>{% endfor %}</div></div></div>{% endmacro %}
{% macro arr() %}<svg class="hz-arr" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"/></svg>{% endmacro %}
{% macro clock() %}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{% endmacro %}

{# Kicker: hub pages show their hub type, news shows its main genre #}
{% macro kick(n) -%}
{%- if n.data.hub_type %}{{ (hubTypes | find('slug', n.data.hub_type)).one }}{% elif n.data.genres and n.data.genres.length %}{{ (genreNav | find('slug', n.data.genres[0])).name }}{% else %}News{% endif -%}
{%- endmacro %}
{% macro chip(n) %}<i class="hz-chip">{{ kick(n) }}</i>{% if n.data.topics and 'gacha' in n.data.topics %} <i class="hz-chip hz-gacha">Gacha</i>{% endif %}{% endmacro %}
{% macro when(n) %}{{ n.data.updated_at or n.data.published_at }}{% endmacro %}
{% macro ago(n) %}<span class="hz-ago">{{ clock() }}<time datetime="{{ (n.data.updated_at or n.data.published_at) | isoDate }}">{{ (n.data.updated_at or n.data.published_at) | longDate }}</time></span>{% endmacro %}

{# Title card used in grids (gz-tc) #}
{% macro tc(n, pre) %}<a class="gz-tc" href="{{ n.url | relp(pre) }}"><span class="gz-pic"><img src="{{ n.data.image | wsrc(480) | relp(pre) }}" alt="" width="480" height="270" loading="lazy" decoding="async" style="object-position:{{ n.data.image_pos or '50% 50%' }}"></span><b>{{ n.data.title }}</b><time class="mono" datetime="{{ (n.data.updated_at or n.data.published_at) | isoDate }}">{{ (n.data.updated_at or n.data.published_at) | longDate }}</time></a>{% endmacro %}

{# Section-page card (gz-rc), big for the lead #}
{% macro rc(n, pre, big=false) %}<a class="gz-rc{% if big %} big{% endif %}" href="{{ n.url | relp(pre) }}"><span class="gz-pic"><img src="{{ n.data.image | wsrc(960 if big else 480) | relp(pre) }}" alt="" width="{{ 960 if big else 480 }}" height="{{ 540 if big else 270 }}" style="object-position:{{ n.data.image_pos or '50% 50%' }}"{% if not big %} loading="lazy"{% endif %} decoding="async"></span><span class="gz-rc-tx"><b>{{ n.data.title }}</b>{% if big %}<span class="gz-rc-d">{{ n.data.summary }}</span>{% endif %}<time class="mono" datetime="{{ (n.data.updated_at or n.data.published_at) | isoDate }}">{{ (n.data.updated_at or n.data.published_at) | longDate }}</time></span></a>{% endmacro %}

{# Row in the "everything" list (hz-all) #}
{% macro allrow(n, pre) %}<li data-s="{{ (n.data.genres or [''])[0] }}"><a href="{{ n.url | relp(pre) }}"><time class="hz-all-d mono" datetime="{{ (n.data.updated_at or n.data.published_at) | isoDate }}">{{ (n.data.updated_at or n.data.published_at) | shortDate }}</time><span class="hz-th"><img src="{{ n.data.image | wsrc(480) | relp(pre) }}" alt="" width="480" height="270" style="object-position:{{ n.data.image_pos or '50% 50%' }}" loading="lazy" decoding="async"></span><span class="hz-all-tx">{{ chip(n) }}<b>{{ n.data.title }}</b><span>{{ n.data.summary }}</span></span>{{ arr() }}</a></li>{% endmacro %}

{# Section page: header + tabs + lead grid + archive #}
{% macro listing(items, pre, kicker, heading, desc, stats, tabs, skipGenre='') %}
<header class="gz-phead lr-head">
<p class="gz-crumbs mono"><a href="{{ '/index.html' | relp(pre) }}">Home</a> / {{ kicker | safe }}</p>
<h1>{{ heading }}</h1>
<p class="gz-phead-d">{{ desc }}</p>
</header>
{{ tabs | safe }}
<div class="lr-grid">
<div class="lr-main">
{% if items.length %}{% set f = items[0] %}<a class="cc-f cc-fg nf gp-lead" href="{{ f.url | relp(pre) }}"><span class="nf-in"><img class="cc-fbg" src="{{ f.data.image | wsrc(960) | relp(pre) }}" srcset="{{ f.data.image | srcset }}" sizes="(max-width: 700px) 100vw, 900px" alt="" width="960" height="540" fetchpriority="high" decoding="async"><span class="cc-tab">{{ kick(f) }}</span><b>{{ f.data.title }}</b><i class="cc-go">{{ arr() }}</i></span></a>
<p class="gp-lead-d">{{ f.data.summary }}</p>
{% if items.length > 1 %}<section class="hz-all lr-list" aria-label="More"><ol>{% for n in items %}{% if not loop.first %}{{ allrow(n, pre) }}{% endif %}{% endfor %}</ol></section>{% endif %}
{% else %}{{ moment(['head-aqua-girl','head-cat-boy','head-shrine-girl'][heading | length % 3], false, 'Nothing here yet', 'This section is still being prepared. Patch trackers and guides are ready in the meantime.', [['Patch trackers','/hub/patch-trackers.html'],['Guides','/hub/guides.html']]) }}{% endif %}
</div>
{{ listrail(skipGenre) }}
</div>
{% if items.length %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"CollectionPage","url":"{{ site.url }}{{ page.url }}","name":{{ heading | unent | jsonify | safe }},"mainEntity":{"@type":"ItemList","itemListElement":[{% for n in items | limit(30) %}{"@type":"ListItem","position":{{ loop.index }},"url":"{{ site.url }}{{ n.url }}"}{% if not loop.last %},{% endif %}{% endfor %}]}}</script>{% endif %}
{% endmacro %}

{# "Get the game" box with official store links #}
{% macro getgame(slug, pre) %}{% set g = games[slug] %}{% if g %}
<div class="gz-box"><div class="gz-box-h"><h2>Get the game</h2></div>
<a class="gz-rtitle kx-gt" href="{{ ('/games/' + slug + '.html') | relp(pre) }}">{% if not g.noicon %}<img class="kx-ico" src="{{ ('/assets/img/icons/' + slug + '.webp') | relp(pre) }}" alt="" width="48" height="48" loading="lazy">{% endif %}<span>{{ g.name }} →</span></a>
<p class="w-what">{{ g.publisher }}{% if g.status %} · {{ g.status }}{% endif %}</p>
<div class="mc-stores">{% if g.appstore %}<a href="{{ g.appstore }}" target="_blank" rel="noopener">App Store ↗</a>{% endif %}{% if g.googleplay %}<a href="{{ g.googleplay }}" target="_blank" rel="noopener">Google Play ↗</a>{% endif %}{% if g.official %}<a href="{{ g.official }}" target="_blank" rel="noopener">Official site ↗</a>{% endif %}</div>
</div>{% endif %}{% endmacro %}

{# Shared sidebar for list pages: popular games, Player Hub, gacha spotlight, genres #}
{% macro listrail(skipGenre='') %}{% set all = collections.everything %}
<aside class="lr-side" aria-label="More on MaxCrit">
{% set rank = games | gameRank(all) %}{% if rank.length %}<div class="cc-f nf"><div class="nf-in"><header class="cc-h"><h3>Popular games</h3></header>{% for r in rank | limit(6) %}{% set gg = games[r.slug] %}<a class="hz-rel mx-rel gp-sim" href="{{ ('/games/' + r.slug + '.html') | rel }}">{% if not gg.noicon %}<img class="mx-av" src="{{ ('/assets/img/icons/' + r.slug + '.webp') | rel }}" alt="" width="44" height="44" loading="lazy">{% endif %}<span class="hz-rt"><b class="w">{{ gg.name }}</b><small>{{ gg.publisher }}</small></span></a>{% endfor %}<a class="cc-btn" href="{{ '/games.html' | rel }}">Games A–Z {{ arr() }}</a></div></div>{% endif %}
{% if collections.hub.length %}<div class="cc-f nf"><div class="nf-in"><header class="cc-h"><h3>Player Hub</h3></header>{% for n in collections.hub | limit(4) %}<a class="cc-li" href="{{ n.url | rel }}">{{ n.data.title }}</a>{% endfor %}<a class="cc-btn cy" href="{{ '/hub.html' | rel }}">All hub pages {{ arr() }}</a></div></div>{% endif %}
{% set gs = all | byTopic('gacha') %}{% if gs.length %}{% set f = gs[0] %}<a class="cc-f cc-fg nf lr-spot" href="{{ f.url | rel }}"><span class="nf-in"><img class="cc-fbg" src="{{ f.data.image | wsrc(480) | rel }}" alt="" width="480" height="270" loading="lazy" decoding="async"><span class="cc-tab">Gacha spotlight</span><b>{{ f.data.title }}</b></span></a>{% endif %}
<div class="cc-f nf"><div class="nf-in"><header class="cc-h"><h3>Genres</h3></header><div class="lr-genres">{% for g in genreNav %}{% if g.slug != skipGenre and (all | byGenre(g.slug)).length %}<a href="{{ ('/genre/' + g.slug + '.html') | rel }}"><img src="{{ ('/assets/img/micons/' + g.slug + '.webp') | rel }}" alt="" width="30" height="30" loading="lazy"><span>{{ g.name }}</span></a>{% endif %}{% endfor %}</div></div></div>
</aside>{% endmacro %}
