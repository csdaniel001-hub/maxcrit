---
layout: base.njk
bodyClass: gz-art
---
{% from "macros.njk" import tc, getgame with context %}
{% set body = content | anchors %}
{% set tocItems = content | toc %}
{% set isHub = hub_type %}
{% set ht = hubTypes | find('slug', hub_type) %}
<article class="gz-article article ar{% if isHub %} is-hub{% endif %}">
<p class="gz-crumbs mono ar-crumbs"><a href="{{ '/index.html' | rel }}">Home</a> / {% if isHub %}<a href="{{ '/hub.html' | rel }}">Player Hub</a> / <a href="{{ ('/hub/' + hub_type + '.html') | rel }}">{{ ht.name }}</a>{% else %}<a href="{{ '/news.html' | rel }}">News</a>{% endif %}{% for gs in genres or [] %} / <a href="{{ ('/genre/' + gs + '.html') | rel }}">{{ (genreNav | find('slug', gs)).name }}</a>{% endfor %}{% for t in topics or [] %} / <a href="{{ ('/' + t + '.html') | rel }}">{{ (topicNav | find('slug', t)).name }}</a>{% endfor %}</p>
<div class="cc ar-hero"><div class="cc-main"><section class="hz-panel hz-hero ar-hz" aria-label="Article header">
<div class="hz-in"><div class="hz-stage"><div class="hz-slide on">
<span class="hz-tx"><span class="hz-hh">{% if isHub %}Player Hub<i aria-hidden="true">//</i>{{ ht.name }}{% else %}News{% if genres and genres.length %}<i aria-hidden="true">//</i>{{ (genreNav | find('slug', genres[0])).name }}{% endif %}{% endif %}</span>
<span class="hz-txb"><h1 class="hz-ht">{{ title }}</h1><span class="hz-hd">{{ summary }}</span>
<span class="hz-btns"><time class="hz-b2" datetime="{{ (updated_at or published_at) | isoDate }}">{% if isHub %}Checked {% endif %}{{ (updated_at or published_at) | longDate }}</time>{% if platforms and platforms.length %}<span class="hz-b2 ar-plat">{% for p in platforms %}{{ (platformNav | find('slug', p)).name }}{% if not loop.last %} · {% endif %}{% endfor %}</span>{% endif %}</span></span></span>
<span class="hz-art"><img src="{{ image | wsrc(960) | rel }}" srcset="{{ image | srcset }}" sizes="(max-width: 700px) 100vw, 900px" width="1600" height="900" alt="{{ image_alt or title }}" style="object-position:{{ image_pos or '50% 50%' }}" fetchpriority="high" decoding="async"></span>
</div></div></div>
</section><p class="ar-credit mono"><span>Image: {{ image_credit }}</span><a href="{{ image_source }}" target="_blank" rel="noopener">source ↗</a></p></div></div>
<div class="gz-agrid">
<div class="gz-abody">
{% if tldr %}<div class="gz-tldr"><h2>The short version</h2><ul>{% for t in tldr %}<li>{{ t | safe }}</li>{% endfor %}</ul></div>{% endif %}
<div class="gz-prose">{{ body | safe }}</div>
{% if faq %}<section class="gz-faq" id="faq"><h2>FAQ</h2>{% for q in faq %}<details{% if loop.first %} open{% endif %}><summary>{{ q.q }}</summary><div>{{ q.a | safe }}</div></details>{% endfor %}</section>{% endif %}
<section class="gz-src" aria-labelledby="h-src"><h2 id="h-src" class="mono">Sources</h2><ol>{% for s in sources %}<li><a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.title }} ↗</a><span class="mono">{% if s.primary %}primary{% else %}supporting{% endif %}</span></li>{% endfor %}</ol></section>
{% set head = page.url | pick(['moon-fox','shrine-girl','cat-boy','aqua-girl','baby-dragon','sakura','blossom','crystal','flame']) %}<div class="kx-end"><img class="kx-cat kx-endh" src="{{ ('/assets/img/chars/head-' + head + '.webp') | rel }}" alt="" width="{{ chars['head-' + head][0] }}" height="{{ chars['head-' + head][1] }}" loading="lazy"><p><b>That's the whole story.</b> Want more? <a href="{{ ('/hub.html' if isHub else '/news.html') | rel }}">{% if isHub %}See the Player Hub{% else %}See the latest news{% endif %}</a></p></div>
</div>
<aside class="gz-arail">
{% if (titles or []).length > 2 %}<div class="gz-box"><div class="gz-box-h"><h2>Games in this article</h2></div>
<ul class="mc-gamelist">{% for slug in titles %}{% set g = games[slug] %}{% if g %}<li><a href="{{ ('/games/' + slug + '.html') | relp(pre) }}">{{ g.name }} →</a><span>{{ g.publisher }}</span></li>{% endif %}{% endfor %}</ul></div>
{% else %}{% for slug in titles or [] %}{{ getgame(slug, pre) }}{% endfor %}{% endif %}
{% if tocItems.length > 1 %}<nav class="gz-toc" aria-label="Contents"><h2 class="mono">Contents</h2><ol>{% for t in tocItems %}<li><a href="#{{ t.id }}">{{ t.text }}</a></li>{% endfor %}</ol></nav>{% endif %}
{% set side = collections.everything | exclude(page.url) | limit(5) %}<section class="cc-news nf ar-latest" aria-labelledby="h-arl"><div class="nf-in"><header class="cc-h"><h2 id="h-arl">Latest news</h2><a class="hz-link" href="{{ '/news.html' | rel }}">All</a></header>{% for n in side %}<a class="cc-nr" href="{{ n.url | rel }}"><span class="cc-nt"><img src="{{ n.data.image | wsrc(480) | rel }}" alt="" width="480" height="270" loading="lazy" decoding="async"></span><span class="cc-nx"><b>{{ n.data.title }}</b><time datetime="{{ (n.data.updated_at or n.data.published_at) | isoDate }}">{{ (n.data.updated_at or n.data.published_at) | shortDate | capitalize }}</time></span></a>{% endfor %}</div></section>
</aside>
</div>
</article>
{% set more = (collections.hub if isHub else collections.news) | exclude(page.url) | limit(4) %}
{% if more.length %}<section class="gz-rovat gz-amore" aria-labelledby="h-more"><header class="gz-h"><h2 id="h-more">{% if isHub %}More from the Player Hub{% else %}More news{% endif %}</h2><a class="gz-more mono" href="{{ ('/hub.html' if isHub else '/news.html') | rel }}">See all →</a></header>
<div class="gz-cgrid">{% for n in more %}{{ tc(n, pre) }}{% endfor %}</div></section>{% endif %}
{% set gname = (games[titles[0]].name if (titles and games[titles[0]]) else '') %}<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"{% if isHub %}Article{% else %}NewsArticle{% endif %}","@id":"{{ site.url }}{{ page.url }}#article","mainEntityOfPage":"{{ site.url }}{{ page.url }}","headline":{{ title | jsonify | safe }},"alternativeHeadline":{{ (seo_title or title) | jsonify | safe }},"description":{{ summary | jsonify | safe }},"inLanguage":"en","datePublished":"{{ published_at | isoDate }}","dateModified":"{{ (updated_at or published_at) | isoDate }}","author":{"@type":"Organization","name":"{{ site.name }}","url":"{{ site.url }}/about.html"},"publisher":{"@type":"Organization","@id":"{{ site.url }}/#org","name":"{{ site.name }}","url":"{{ site.url }}/","logo":{"@type":"ImageObject","url":"{{ site.url }}/assets/img/share/logo.png","width":512,"height":512}},"image":{"@type":"ImageObject","url":"{{ site.url }}{{ image }}","width":1600,"height":900,"caption":{{ (image_alt or title) | jsonify | safe }},"creditText":{{ (image_credit or '') | jsonify | safe }}},"wordCount":{{ content | wordcount }}{% if keyword %},"keywords":{{ keyword | jsonify | safe }}{% endif %}{% if genres and genres[0] %},"articleSection":{{ (genreNav | find('slug', genres[0])).name | jsonify | safe }}{% endif %}{% if titles and titles.length %},"about":[{% for t in titles %}{% if games[t] %}{"@type":"VideoGame","name":{{ games[t].name | jsonify | safe }},"url":"{{ site.url }}/games/{{ t }}.html"{% if games[t].publisher %},"publisher":{"@type":"Organization","name":{{ games[t].publisher | jsonify | safe }}}{% endif %}}{% if not loop.last %},{% endif %}{% endif %}{% endfor %}]{% endif %},"citation":[{% for s in sources %}{"@type":"CreativeWork","name":{{ s.title | jsonify | safe }},"url":{{ s.url | jsonify | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},{% if isHub %}{"@type":"ListItem","position":2,"name":"Player Hub","item":"{{ site.url }}/hub.html"},{"@type":"ListItem","position":3,"name":{{ ht.name | jsonify | safe }},"item":"{{ site.url }}/hub/{{ hub_type }}.html"},{"@type":"ListItem","position":4,"name":{{ title | jsonify | safe }}}{% else %}{"@type":"ListItem","position":2,"name":"News","item":"{{ site.url }}/news.html"},{"@type":"ListItem","position":3,"name":{{ title | jsonify | safe }}}{% endif %}]}]}</script>
{% if faq %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for q in faq %}{"@type":"Question","name":{{ q.q | jsonify | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ q.a | striptags | jsonify | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}</script>{% endif %}
