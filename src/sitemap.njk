---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% set lm = (collections.everything[0].data.updated_at or collections.everything[0].data.published_at) | isoDate %}<url><loc>{{ site.url }}/</loc><lastmod>{{ lm }}</lastmod></url>
<url><loc>{{ site.url }}/news.html</loc><lastmod>{{ lm }}</lastmod></url>
<url><loc>{{ site.url }}/hub.html</loc>{% if collections.hub.length %}<lastmod>{{ (collections.hub[0].data.updated_at or collections.hub[0].data.published_at) | isoDate }}</lastmod>{% endif %}</url>
<url><loc>{{ site.url }}/games.html</loc><lastmod>{{ lm }}</lastmod></url>
<url><loc>{{ site.url }}/about.html</loc></url>
{% for n in collections.everything %}<url><loc>{{ site.url }}{{ n.url }}</loc><lastmod>{{ (n.data.updated_at or n.data.published_at) | isoDate }}</lastmod></url>
{% endfor %}{% for t in topicNav %}{% if (collections.everything | byTopic(t.slug)).length %}<url><loc>{{ site.url }}/{{ t.slug }}.html</loc></url>
{% endif %}{% endfor %}{% for g in genreNav %}{% if (collections.everything | byGenre(g.slug)).length %}<url><loc>{{ site.url }}/genre/{{ g.slug }}.html</loc></url>
{% endif %}{% endfor %}{% for h in hubTypes %}{% if (collections.hub | byHubType(h.slug)).length %}<url><loc>{{ site.url }}/hub/{{ h.slug }}.html</loc></url>
{% endif %}{% endfor %}{% for p in platformNav %}{% set pc = collections.everything | byPlatform(p.slug) %}{% if pc.length %}<url><loc>{{ site.url }}/platform/{{ p.slug }}.html</loc><lastmod>{{ (pc[0].data.updated_at or pc[0].data.published_at) | isoDate }}</lastmod></url>
{% endif %}{% endfor %}{% for slug, g in games %}{% if (collections.everything | byGame(slug)).length %}<url><loc>{{ site.url }}/games/{{ slug }}.html</loc></url>
{% endif %}{% endfor %}</urlset>
