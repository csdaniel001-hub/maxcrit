---
layout: base.njk
permalink: /index.html
bodyClass: hz-home
---
{% from "macros.njk" import arr, clock, chip, kick, ago, allrow with context %}
{% set all = collections.everything %}
{% set hero = all | featured | limit(4) %}
{% set fresh = all | notIn(hero) | limit(3) %}
<div class="hz-top">
<section class="hz-panel hz-hero" id="gzHero" aria-roledescription="carousel" aria-label="Featured stories">
<div class="hz-in">
<div class="hz-stage">
{% for n in hero %}<a class="hz-slide{% if loop.first %} on{% endif %}" href="{{ n.url | rel }}">
<span class="hz-tx"><span class="hz-hh">Featured<i aria-hidden="true">//</i>{{ kick(n) }}</span>
<span class="hz-txb"><b class="hz-ht">{{ n.data.title }}</b><span class="hz-hd">{{ n.data.summary }}</span>
<span class="hz-btns"><span class="hz-b1">Read more {{ arr() }}</span><span class="hz-b2">{{ (n.data.updated_at or n.data.published_at) | longDate }}</span></span></span></span>
<span class="hz-art"><img src="{{ n.data.image | rel }}" alt="{{ n.data.image_alt or n.data.title }}" style="object-position:{{ n.data.image_pos or '50% 50%' }}"{% if loop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %}></span>
</a>
{% endfor %}</div>
<div class="hz-ctl">{% for n in hero %}<button type="button" class="{% if loop.first %}on{% endif %}" aria-label="Featured story {{ loop.index }}"></button>{% endfor %}<span id="gzCount">01 / 0{{ hero.length }}</span></div>
<div class="hz-nav"><button type="button" id="gzPrev" aria-label="Previous story"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 12H4M10 6l-6 6 6 6"/></svg></button><button type="button" id="gzNext" aria-label="Next story"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 12h16M14 6l6 6-6 6"/></svg></button></div>
</div>
</section>
<section class="hz-panel hz-dark hz-fresh" aria-labelledby="h-fresh">
<div class="hz-in">
<header class="hz-ph"><h2 id="h-fresh">Latest</h2><i aria-hidden="true">//</i></header>
<ol>{% for n in fresh %}<li><a href="{{ n.url | rel }}"><span class="hz-n">0{{ loop.index }}</span><span class="hz-th"><img src="{{ n.data.image | rel }}" alt="" style="object-position:{{ n.data.image_pos or '50% 50%' }}" loading="lazy"></span><span class="hz-ft">{{ chip(n) }}<b>{{ n.data.title }}</b>{{ ago(n) }}</span>{{ arr() }}</a></li>{% endfor %}</ol>
<div class="hz-foot"><a class="hz-link" href="{{ '/news.html' | rel }}">All news {{ arr() }}</a></div>
</div>
</section>
</div>

{% macro ico(d) %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="{{ d }}"/></svg>{% endmacro %}
{% macro ui(f) %}{{ ('/assets/img/ui/' + f) | rel }}{% endmacro %}
{% macro go() %}<svg class="mx-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"/></svg>{% endmacro %}
{% macro card(n) %}<a class="hz-card" href="{{ n.url | rel }}"><span class="hz-card-in"><span class="hz-card-pic"><img src="{{ n.data.image | rel }}" alt="" style="object-position:{{ n.data.image_pos or '50% 50%' }}" loading="lazy"><i class="hz-chip">{{ kick(n) }}</i></span><span class="hz-card-tx"><b>{{ n.data.title }}</b></span></span></a>{% endmacro %}
{% set rank = games | gameRank(all) %}

{# 1. Popular games: the most-covered games #}
<section class="mc-sec" aria-labelledby="h-pop">
<header class="hz-sh"><img class="nx-ic" src="{{ ui('el-p05.png') }}" alt=""><h2 id="h-pop">Popular games</h2><i aria-hidden="true">//</i><a class="hz-link" href="{{ '/games.html' | rel }}">Games A–Z {{ arr() }}</a></header>
<div class="mc-gs">{% for r in rank | limit(8) %}<a class="hz-card" href="{{ ('/games/' + r.slug + '.html') | rel }}"><span class="hz-card-in"><span class="hz-card-pic"><img src="{{ all | gamePic(r.slug) | rel }}" alt="" loading="lazy"></span><span class="hz-card-tx"><b>{{ games[r.slug].name }}</b><small>{{ r.n }} {{ 'story' if r.n == 1 else 'stories' }}</small></span></span></a>{% endfor %}</div>
</section>

{# 2. Latest news: one feed with genre filters #}
<section class="hz-all" aria-labelledby="h-all">
<header class="hz-sh"><h2 id="h-all">Latest news</h2><i aria-hidden="true">//</i>
<div class="hz-tabs"><button type="button" class="on" data-f="all">All</button>{% for g in genreNav %}{% if (all | byGenre(g.slug)).length %}<button type="button" data-f="{{ g.slug }}">{{ g.name }}</button>{% endif %}{% endfor %}</div>
</header>
<ol id="gzAll">{% for n in all %}{{ allrow(n, pre) }}{% endfor %}</ol>
<div class="hz-all-f"><button type="button" class="hz-moreb" id="gzMoreB" hidden>Load more <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 4v16M6 14l6 6 6-6"/></svg></button><a class="hz-link" href="{{ '/news.html' | rel }}">News archive {{ arr() }}</a></div>
</section>


{# 3. Gacha games #}
{% set gi = all | byTopic('gacha') | notIn(hero.concat(fresh)) %}
{% if gi.length %}
<section class="hz-rb mx-gacha" aria-labelledby="h-rb-t-gacha">
<a class="hz-rbh" href="{{ '/gacha.html' | rel }}"><span class="hz-rbh-tx"><span class="mx-pad"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 11h4M8 9v4M15 12h.01M18 10h.01M17.32 5H6.68a4 4 0 0 0-3.98 3.59C2.6 9.42 2 14.46 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.41-1.41A2 2 0 0 1 9.83 16h4.34a2 2 0 0 1 1.41.59L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.55-.6-6.58-.69-7.26A4 4 0 0 0 17.32 5z"/></svg><i></i></span><h2 id="h-rb-t-gacha">Gacha games</h2><span class="mc-stars" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg></span></span><span class="mx-chibi-w"><img src="{{ ui('chibi-gamer.png') }}" alt=""></span><span class="hz-rbh-go">Open section {{ arr() }}</span><span class="mx-props"><img class="q1" src="{{ ui('crys-blue.png') }}" alt=""><img class="q2" src="{{ ui('star-crystal.png') }}" alt=""><img class="q3" src="{{ ui('cards2.png') }}" alt=""><img class="q4" src="{{ ui('chest-magic.png') }}" alt=""><img class="q5" src="{{ ui('crys-pink.png') }}" alt=""></span></a>
<div class="hz-panel hz-rv"><div class="hz-in"><div class="hz-rv-g s3">
{% set f = gi[0] %}<a class="hz-rv-lead" href="{{ f.url | rel }}"><span class="hz-rv-pic"><img src="{{ f.data.image | rel }}" alt="" style="object-position:{{ f.data.image_pos or '50% 50%' }}" loading="lazy"></span><b>{{ f.data.title }}</b><span class="hz-rv-d">{{ f.data.summary }}</span>{{ ago(f) }}</a>
<div class="hz-rv-list">{% for n in gi | limit(5) %}{% if not loop.first %}<a class="hz-rv-row" href="{{ n.url | rel }}"><span class="hz-th"><img src="{{ n.data.image | rel }}" alt="" style="object-position:{{ n.data.image_pos or '50% 50%' }}" loading="lazy"></span><span class="hz-ft"><b>{{ n.data.title }}</b>{{ ago(n) }}</span></a>{% endif %}{% endfor %}</div>
<div class="hz-rv-side"><h3>Games <i>//</i></h3>{% set seen = [] %}{% for n in gi %}{% for t in n.data.titles or [] %}{% if t not in seen and seen.length < 5 %}{% set seen = (seen.push(t), seen) %}<a class="hz-rel mx-rel" href="{{ ('/games/' + t + '.html') | rel }}"><img class="mx-av" src="{{ all | gamePic(t) | rel }}" alt=""><span class="hz-rt"><b class="w">{{ games[t].name }}</b><small>{{ games[t].publisher }}</small></span>{{ go() }}</a>{% endif %}{% endfor %}{% endfor %}<div class="mx-foot"><img class="mx-cat" src="{{ ui('cat-pink.png') }}" alt=""><a class="hz-link" href="{{ '/games.html' | rel }}">Games A–Z {{ arr() }}</a></div></div>
</div></div></div>
</section>
{% endif %}

{# 4. Player Hub, one column per hub type that has pages #}
{% set hubIcons = {'patch-trackers': 'el-p49.png', 'guides': 'el-p46.png', 'banners': 'cards2.png', 'codes': 'tickets.png', 'tier-lists': 'star-crystal.png'} %}
{% if collections.hub.length %}<div class="mc-sec">
<section class="hz-panel hz-dark mx-hub nx-hub" aria-labelledby="h-hub"><div class="hz-in">
<header class="hz-ph"><h2 id="h-hub">Player Hub</h2><i aria-hidden="true">//</i><a class="hz-link mc-ph-link" href="{{ '/hub.html' | rel }}">All hub pages {{ arr() }}</a></header>
<div class="nx-hubgrid">{% for h in hubTypes %}{% set hp = collections.hub | byHubType(h.slug) %}{% if hp.length %}<div class="nx-hubcol"><header><img src="{{ ui(hubIcons[h.slug] or 'el-p05.png') }}" alt=""><h3>{{ h.name }}</h3><a class="hz-link" href="{{ ('/hub/' + h.slug + '.html') | rel }}">All {{ arr() }}</a></header>{% for n in hp | limit(3) %}<a class="hz-rel" href="{{ n.url | rel }}"><span class="hz-rt"><b>{{ n.data.title }}</b></span>{{ arr() }}</a>{% endfor %}</div>{% endif %}{% endfor %}</div>
</div></section>
</div>{% endif %}

{# 5. Game spotlights: the two most-covered games #}
{% for r in rank | limit(2) %}{% set sp = all | soloByGame(r.slug) %}
<section class="mc-sec" aria-labelledby="h-sp-{{ r.slug }}">
<header class="hz-sh"><h2 id="h-sp-{{ r.slug }}">{{ games[r.slug].name }}</h2><i aria-hidden="true">//</i><a class="hz-link" href="{{ ('/games/' + r.slug + '.html') | rel }}">All {{ games[r.slug].name }} {{ arr() }}</a></header>
<div class="hz-cards mc-n{{ 4 if sp.length > 4 else sp.length }}">{% for n in sp | limit(4) %}{{ card(n) }}{% endfor %}</div>
</section>
{% endfor %}

<script>
(function(){
if('IntersectionObserver' in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches){document.documentElement.classList.add('gz-an');var io=new IntersectionObserver(function(es){var k=0;es.forEach(function(e){if(!e.isIntersecting)return;e.target.style.transitionDelay=(k++*60)+'ms';e.target.classList.add('in');io.unobserve(e.target)})},{rootMargin:'0px 0px -6% 0px'});document.querySelectorAll('.hz-panel,.hz-rbh,.hz-sh,.hz-card').forEach(function(el){io.observe(el)});}
var h=document.getElementById('gzHero');
if(h){var s=h.querySelectorAll('.hz-slide'),d=h.querySelectorAll('.hz-ctl button'),c=document.getElementById('gzCount'),i=0,tm;
function go(n){s[i].classList.remove('on');d[i].classList.remove('on');i=(n+s.length)%s.length;s[i].classList.add('on');d[i].classList.add('on');if(c)c.textContent='0'+(i+1)+' / 0'+s.length;}
function auto(){clearInterval(tm);if(!matchMedia('(prefers-reduced-motion: reduce)').matches)tm=setInterval(function(){go(i+1)},7000);}
d.forEach(function(b,k){b.addEventListener('click',function(){go(k);auto()})});
document.getElementById('gzPrev').addEventListener('click',function(){go(i-1);auto()});
document.getElementById('gzNext').addEventListener('click',function(){go(i+1);auto()});
h.addEventListener('mouseenter',function(){clearInterval(tm)});h.addEventListener('mouseleave',auto);h.addEventListener('focusin',function(){clearInterval(tm)});auto();}
var now=Date.now();document.querySelectorAll('.hz-ago time').forEach(function(t){var m=(now-new Date(t.getAttribute('datetime')))/6e4;if(m<0||isNaN(m)||m>=10080)return;t.textContent=m<60?Math.max(1,Math.round(m))+' min ago':m<1440?Math.round(m/60)+' h ago':Math.round(m/1440)+(Math.round(m/1440)===1?' day ago':' days ago');});
var tabs=document.querySelectorAll('.hz-tabs button'),al=[].slice.call(document.querySelectorAll('#gzAll li')),mb=document.getElementById('gzMoreB'),ac=document.getElementById('gzAllC'),flt='all',vis=6;
function paint(){var n=0,tot=0;al.forEach(function(li){var ok=flt==='all'||li.dataset.s===flt;if(ok)tot++;li.hidden=!(ok&&n<vis);if(ok&&n<vis)n++;});if(ac)ac.textContent=n+' / '+tot+' stories';if(mb)mb.hidden=n>=tot;}
tabs.forEach(function(b){b.addEventListener('click',function(){tabs.forEach(function(x){x.classList.toggle('on',x===b)});flt=b.dataset.f;vis=6;paint()})});
if(mb)mb.addEventListener('click',function(){vis+=6;paint()});paint();
})();
</script>
