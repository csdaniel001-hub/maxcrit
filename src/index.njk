---
layout: base.njk
permalink: /index.html
bodyClass: hz-home
---
{% from "macros.njk" import arr, clock, chip, kick, ago, allrow with context %}
{% set all = collections.stories %}
{% set news = collections.news %}
{% set hero = news | notGenre('hardware') | diverseFeatured(4) %}
{% macro pic(img, w, cls='', lazy=true, pos='') %}<img{% if cls %} class="{{ cls }}"{% endif %} src="{{ img | wsrc(w) | rel }}" alt="" width="{{ w }}" height="{{ (w * 9 / 16) | round }}"{% if pos %} style="object-position:{{ pos }}"{% endif %}{% if lazy %} loading="lazy"{% endif %} decoding="async">{% endmacro %}
{% macro ui(f) %}{{ ('/assets/img/ui/' + f) | rel }}{% endmacro %}
{% macro go() %}<svg class="mx-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"/></svg>{% endmacro %}
{% macro card(n) %}<a class="hz-card" href="{{ n.url | rel }}"><span class="hz-card-in"><span class="hz-card-pic">{{ pic(n.data.image, 480, '', true, n.data.image_pos or '50% 50%') }}<i class="hz-chip">{{ kick(n) }}</i></span><span class="hz-card-tx"><b>{{ n.data.title }}</b></span></span></a>{% endmacro %}
{% set rank = games | gameRank(all) %}
{% set gi = all | byTopic('gacha') | notIn(hero) %}
{% set gl = [] %}{% for slug, g in games %}{% if (all | byGame(slug)).length %}{% set gl = (gl.push(slug), gl) %}{% endif %}{% endfor %}

<h1 class="gz-sr">{{ site.name }}: mobile gaming news, patch trackers and guides</h1>
<div class="cc"><div class="cc-main"><section class="hz-panel hz-hero" id="gzHero" aria-roledescription="carousel" aria-label="Featured stories">
<div class="hz-in">
<div class="hz-stage">
{% for n in hero %}<a class="hz-slide{% if loop.first %} on{% endif %}" href="{{ n.url | rel }}">
<span class="hz-tx"><span class="hz-hh">Featured<i aria-hidden="true">//</i>{{ kick(n) }}</span>
<span class="hz-txb"><b class="hz-ht">{{ n.data.title }}</b><span class="hz-hd">{{ n.data.summary }}</span>
<span class="hz-btns"><span class="hz-b1">Read more {{ arr() }}</span><span class="hz-b2">{{ (n.data.updated_at or n.data.published_at) | longDate }}</span></span></span></span>
<span class="hz-art"><img src="{{ n.data.image | wsrc(960) | rel }}" srcset="{{ n.data.image | srcset }}" sizes="(max-width: 700px) 100vw, 900px" width="1600" height="900" alt="{{ n.data.image_alt or n.data.title }}" style="object-position:{{ n.data.image_pos or '50% 50%' }}"{% if loop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async"></span>
</a>
{% endfor %}</div>
<div class="hz-ctl">{% for n in hero %}<button type="button" class="{% if loop.first %}on{% endif %}" aria-label="Featured story {{ loop.index }}"></button>{% endfor %}<span id="gzCount">01 / 0{{ hero.length }}</span></div>
<div class="hz-nav"><button type="button" id="gzPrev" aria-label="Previous story"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 12H4M10 6l-6 6 6 6"/></svg></button><button type="button" id="gzNext" aria-label="Next story"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 12h16M14 6l6 6-6 6"/></svg></button></div>
<div class="cc-s3">{% for n in hero %}{% if not loop.first %}<a class="cc-sc" href="{{ n.url | rel }}">{{ pic(n.data.image, 480) }}<span class="cc-tab">{{ kick(n) }}</span><b>{{ n.data.title }}</b><i class="cc-go">{{ arr() }}</i></a>{% endif %}{% endfor %}</div></div>
</section><div class="cc-quick"><a class="cc-q nf" href="{{ '/hub/patch-trackers.html' | rel }}"><span class="nf-in"><img class="kx-head" src="{{ '/assets/img/chars/head-aqua-girl.webp' | rel }}" alt="" width="{{ chars['head-aqua-girl'][0] }}" height="{{ chars['head-aqua-girl'][1] }}" aria-hidden="true" loading="lazy"><img src="{{ ui('el-p49.webp') }}" alt="" width="56" height="56"><span><b>Patch trackers</b><i>Every update, in order</i></span></span></a><a class="cc-q nf" href="{{ '/hub/guides.html' | rel }}"><span class="nf-in"><img class="kx-head" src="{{ '/assets/img/chars/head-moon-fox.webp' | rel }}" alt="" width="{{ chars['head-moon-fox'][0] }}" height="{{ chars['head-moon-fox'][1] }}" aria-hidden="true" loading="lazy"><img src="{{ ui('el-p46.webp') }}" alt="" width="56" height="56"><span><b>Guides</b><i>How things work</i></span></span></a><a class="cc-q nf" href="{{ '/gacha.html' | rel }}"><span class="nf-in"><img class="kx-head" src="{{ '/assets/img/chars/head-shrine-girl.webp' | rel }}" alt="" width="{{ chars['head-shrine-girl'][0] }}" height="{{ chars['head-shrine-girl'][1] }}" aria-hidden="true" loading="lazy"><img src="{{ ui('cards2.webp') }}" alt="" width="69" height="56"><span><b>Gacha games</b><i>Banners, versions, events</i></span></span></a><a class="cc-q nf" href="{{ '/games.html' | rel }}"><span class="nf-in"><img class="kx-head" src="{{ '/assets/img/chars/head-baby-dragon.webp' | rel }}" alt="" width="{{ chars['head-baby-dragon'][0] }}" height="{{ chars['head-baby-dragon'][1] }}" aria-hidden="true" loading="lazy"><img src="{{ ui('chest-magic.webp') }}" alt="" width="68" height="56"><span><b>Game index</b><i>{{ gl.length }} games A to Z</i></span></span></a></div><div class="cc-feat">
{% if gi.length %}{% set f = gi[0] %}<a class="cc-f cc-fg nf" href="{{ f.url | rel }}"><span class="nf-in"><img class="cc-fbg" src="{{ f.data.image | wsrc(960) | rel }}" srcset="{{ f.data.image | srcset }}" sizes="(max-width: 700px) 100vw, 640px" alt="" width="960" height="540" decoding="async"><span class="cc-tab">Gacha spotlight</span><b>{{ f.data.title }}</b><i class="cc-go">{{ arr() }}</i></span></a>{% endif %}
{% set gd = collections.hub | byHubType('guides') %}{% if gd.length %}<div class="cc-f nf"><div class="nf-in"><header class="cc-h"><h2 class="s">Guides</h2></header>{% for n in gd | limit(2) %}<a class="cc-li" href="{{ n.url | rel }}">{{ n.data.title }}</a>{% endfor %}<img class="cc-fart" src="{{ ui('chest-magic.webp') }}" alt="" width="84" height="70" loading="lazy"><a class="cc-btn cy" href="{{ '/hub/guides.html' | rel }}">All guides {{ arr() }}</a></div></div>{% endif %}
{% set pt = collections.hub | byHubType('patch-trackers') %}{% if pt.length %}<div class="cc-f nf"><div class="nf-in"><header class="cc-h"><h2 class="s">Patch tracker</h2></header>{% for n in pt | limit(2) %}<a class="cc-li" href="{{ n.url | rel }}">{{ n.data.title }}</a>{% endfor %}<a class="cc-btn" href="{{ '/hub/patch-trackers.html' | rel }}">All patch trackers {{ arr() }}</a></div></div>{% endif %}
</div></div><aside class="cc-news nf" aria-labelledby="h-cn"><div class="nf-in"><header class="cc-h"><h2 id="h-cn">Latest news</h2><a class="hz-link" href="{{ '/news.html' | rel }}">All news {{ arr() }}</a></header>{% for n in news | notGenre('hardware') | notIn(hero) | limit(6) %}<a class="cc-nr" href="{{ n.url | rel }}"><span class="cc-nt">{{ pic(n.data.image, 480) }}</span><span class="cc-nx"><i class="cc-tab">{{ kick(n) }}</i><b>{{ n.data.title }}</b><time datetime="{{ (n.data.updated_at or n.data.published_at) | isoDate }}">{{ (n.data.updated_at or n.data.published_at) | shortDate | capitalize }}</time></span>{{ arr() }}</a>{% endfor %}</div></aside></div>

{# Popular games: the most-covered games #}
<section class="mc-sec" aria-labelledby="h-pop">
<header class="hz-sh kx-has-peek"><img class="kx-peek kp-sakura" src="{{ '/assets/img/chars/sakura-kitsune.webp' | rel }}" alt="" width="{{ chars['sakura-kitsune'][0] }}" height="{{ chars['sakura-kitsune'][1] }}" aria-hidden="true" loading="lazy"><img class="nx-ic" src="{{ ui('el-p05.webp') }}" alt="" width="28" height="28"><h2 id="h-pop">Popular games</h2><i aria-hidden="true">//</i><a class="hz-link" href="{{ '/games.html' | rel }}">Games A–Z {{ arr() }}</a></header>
<div class="mc-gs">{% for r in rank | limit(6) %}<a class="hz-card" href="{{ ('/games/' + r.slug + '.html') | rel }}"><span class="hz-card-in"><span class="hz-card-pic">{{ pic(all | gamePic(r.slug), 480) }}</span><span class="hz-card-tx"><b>{{ games[r.slug].name }}</b><small>{{ r.n }} {{ 'story' if r.n == 1 else 'stories' }}</small></span></span></a>{% endfor %}</div>
</section>

{# Latest news: one feed with genre filters #}
<section class="hz-all" aria-labelledby="h-all">
<header class="hz-sh kx-has-peek"><h2 id="h-all">Latest news</h2><i aria-hidden="true">//</i>
<div class="hz-tabs"><button type="button" class="on" data-f="all">All</button>{% for g in genreNav %}{% if (news | limit(24) | byGenre(g.slug)).length %}<button type="button" data-f="{{ g.slug }}">{{ g.name }}</button>{% endif %}{% endfor %}</div>
</header>
<ol id="gzAll">{% for n in news | limit(24) %}{{ allrow(n, pre) }}{% endfor %}</ol>
<div class="hz-all-f"><button type="button" class="hz-moreb" id="gzMoreB" hidden>Load more <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 4v16M6 14l6 6 6-6"/></svg></button><a class="hz-link" href="{{ '/news.html' | rel }}">News archive {{ arr() }}</a></div>
</section>

{# Latest guides and builds: evergreen hub content gets its own block so it never crowds the news surfaces #}
{% set gb = collections.hub | guidesBuilds | limit(6) %}
{% if gb.length %}<section class="mc-sec mc-gb" aria-labelledby="h-gb">
<header class="hz-sh"><img class="nx-ic" src="{{ ui('el-p46.webp') }}" alt="" width="28" height="28"><h2 id="h-gb">Latest guides &amp; builds</h2><i aria-hidden="true">//</i>{% if (collections.hub | byHubType('builds')).length %}<a class="hz-link" href="{{ '/hub/builds.html' | rel }}">Character builds {{ arr() }}</a>{% endif %}{% if (collections.hub | byHubType('guides')).length %}<a class="hz-link" href="{{ '/hub/guides.html' | rel }}">Guides {{ arr() }}</a>{% endif %}</header>
<div class="mc-gs">{% for n in gb %}{{ card(n) }}{% endfor %}</div>
</section>{% endif %}

{# Gacha games #}
{% if gi.length %}
<section class="hz-rb mx-gacha" aria-labelledby="h-rb-t-gacha">
<a class="hz-rbh gx-bar" href="{{ '/gacha.html' | rel }}"><span class="hz-rbh-tx"><span class="mx-pad"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 11h4M8 9v4M15 12h.01M18 10h.01M17.32 5H6.68a4 4 0 0 0-3.98 3.59C2.6 9.42 2 14.46 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.41-1.41A2 2 0 0 1 9.83 16h4.34a2 2 0 0 1 1.41.59L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.55-.6-6.58-.69-7.26A4 4 0 0 0 17.32 5z"/></svg><i></i></span><h2 id="h-rb-t-gacha">Gacha games</h2><span class="mc-stars" aria-hidden="true">{% for k in [1,2,3,4,5] %}<svg viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg>{% endfor %}</span></span><span class="hz-rbh-go kx-hbtn">Open section {{ arr() }}</span><span class="kx-row" aria-hidden="true"><img src="{{ ui('cards2.webp') }}" alt="" width="119" height="96" loading="lazy"></span></a>
<div class="hz-panel hz-rv"><div class="hz-in"><div class="hz-rv-g s3">
{% set f = gi[0] %}<a class="hz-rv-lead" href="{{ f.url | rel }}"><span class="hz-rv-pic">{{ pic(f.data.image, 960, '', true, f.data.image_pos or '50% 50%') }}</span><b>{{ f.data.title }}</b><span class="hz-rv-d">{{ f.data.summary }}</span>{{ ago(f) }}</a>
<div class="hz-rv-list">{% for n in gi | limit(5) %}{% if not loop.first %}<a class="hz-rv-row" href="{{ n.url | rel }}"><span class="hz-th">{{ pic(n.data.image, 480, '', true, n.data.image_pos or '50% 50%') }}</span><span class="hz-ft"><b>{{ n.data.title }}</b>{{ ago(n) }}</span></a>{% endif %}{% endfor %}</div>
<div class="hz-rv-side"><h3>Games <i>//</i></h3>{% set seen = [] %}{% for n in gi %}{% for t in n.data.titles or [] %}{% if t not in seen and seen.length < 5 %}{% set seen = (seen.push(t), seen) %}<a class="hz-rel mx-rel" href="{{ ('/games/' + t + '.html') | rel }}">{% if not games[t].noicon %}<img class="mx-av" src="{{ ('/assets/img/icons/' + t + '.webp') | rel }}" alt="" width="44" height="44" loading="lazy">{% endif %}<span class="hz-rt"><b class="w">{{ games[t].name }}</b><small>{{ games[t].publisher }}</small></span>{{ go() }}</a>{% endif %}{% endfor %}{% endfor %}<div class="mx-foot"><img class="mx-cat" src="{{ ui('cat-pink.webp') }}" alt="" width="45" height="60" loading="lazy"><a class="hz-link" href="{{ '/games.html' | rel }}">Games A–Z {{ arr() }}</a></div></div>
</div></div></div>
</section>
{% endif %}

{# Player Hub, one column per hub type that has pages #}
{% set hubIcons = {'patch-trackers': 'el-p49.webp', 'guides': 'el-p46.webp', 'banners': 'cards2.webp', 'codes': 'cards2.webp', 'tier-lists': 'el-p05.webp'} %}
{% if collections.hub.length %}<div class="mc-sec">
<section class="ph-hub" aria-labelledby="h-hub">
<header class="hz-sh kx-has-peek"><img class="kx-peek kp-blossom" src="{{ '/assets/img/chars/blossom-kitsune.webp' | rel }}" alt="" width="{{ chars['blossom-kitsune'][0] }}" height="{{ chars['blossom-kitsune'][1] }}" aria-hidden="true" loading="lazy"><h2 id="h-hub">Player Hub</h2><i aria-hidden="true">//</i><a class="hz-link" href="{{ '/hub.html' | rel }}">All hub pages {{ arr() }}</a></header>
<div class="ph-grid">{% for h in hubTypes %}{% set hp = collections.hub | byHubType(h.slug) %}{% if hp.length %}{% set top = hp[0] %}<div class="ph-card nf"><div class="nf-in">
<a class="ph-top" href="{{ ('/hub/' + h.slug + '.html') | rel }}">{% set hart = {'patch-trackers': ['fire', '45% 25%'], 'banners': ['lineup', '50% 20%'], 'codes': ['party', '50% 30%'], 'guides': ['dragon', '35% 20%'], 'events': ['ice', '62% 30%'], 'tier-lists': ['bird', '55% 35%']}[h.slug] %}{% if hart %}<img src="{{ ('/assets/img/kit/hdr-' + hart[0] + '-480.webp') | rel }}" srcset="{{ ('/assets/img/kit/hdr-' + hart[0] + '-480.webp') | rel }} 480w, {{ ('/assets/img/kit/hdr-' + hart[0] + '-800.webp') | rel }} 800w" sizes="(max-width: 700px) 92vw, 350px" alt="" width="1400" height="784" style="object-position:{{ hart[1] }}" loading="lazy" decoding="async">{% else %}<img src="{{ top.data.image | wsrc(480) | rel }}" alt="" width="480" height="270" style="object-position:{{ top.data.image_pos or '50% 50%' }}" loading="lazy" decoding="async">{% endif %}<span class="ph-name"><img class="ph-ico" src="{{ ui(hubIcons[h.slug] or 'el-p05.webp') }}" alt="" width="40" height="40" loading="lazy"><b>{{ h.name }}</b><small>{{ hp.length }} page{% if hp.length != 1 %}s{% endif %}</small></span></a>
<ul class="ph-list">{% for n in hp | limit(3) %}<li><a href="{{ n.url | rel }}"><b>{{ n.data.title }}</b>{{ arr() }}</a></li>{% endfor %}</ul>
<a class="ph-all" href="{{ ('/hub/' + h.slug + '.html') | rel }}">All {{ h.name | lower }} {{ arr() }}</a>
</div></div>{% endif %}{% endfor %}<a class="ph-cta nf" href="{{ '/hub.html' | rel }}"><span class="nf-in"><img src="{{ '/assets/img/kit/hdr-trio-480.webp' | rel }}" srcset="{{ '/assets/img/kit/hdr-trio-480.webp' | rel }} 480w, {{ '/assets/img/kit/hdr-trio-800.webp' | rel }} 800w, {{ '/assets/img/kit/hdr-trio.webp' | rel }} 1400w" sizes="(max-width: 900px) 92vw, 1100px" alt="" width="1400" height="784" loading="lazy" decoding="async"><span class="ph-cta-tx"><small>Player Hub</small><b>Every tracker, code list and guide</b><em>Browse all hub pages {{ arr() }}</em></span></span></a></div>
</section>
</div>{% endif %}

{# Genre sections: a framed panel per genre with a lead story and a list (no card grids). Small genres share "More genres". #}
{% set gbig = [] %}{% set gsmall = [] %}
{% for g in genreNav %}{% set fi = all | byGenre(g.slug) %}{% if fi.length >= 4 %}{% set gbig = (gbig.push({g: g, items: fi}), gbig) %}{% elif fi.length %}{% set gsmall = (gsmall.push({g: g, items: fi}), gsmall) %}{% endif %}{% endfor %}
{% for e in gbig %}{% set g = e.g %}{% set f = e.items[0] %}
<section class="mc-sec gs" aria-labelledby="h-g-{{ g.slug }}">
<header class="hz-sh"><h2 id="h-g-{{ g.slug }}">{{ g.name }}</h2><i aria-hidden="true">//</i><a class="hz-link" href="{{ ('/genre/' + g.slug + '.html') | rel }}">All {{ g.name }} {{ arr() }}</a></header>
<div class="gs-box nf"><div class="nf-in gs-in{% if loop.index0 % 2 %} flip{% endif %}">
<a class="gs-lead" href="{{ f.url | rel }}"><span class="gs-pic">{{ pic(f.data.image, 960, '', true, f.data.image_pos or '50% 50%') }}<i class="hz-chip">{{ kick(f) }}</i></span><b>{{ f.data.title }}</b><span class="gs-d">{{ f.data.summary }}</span></a>
<ul class="gs-list">{% for n in e.items | limit(5) %}{% if not loop.first %}<li><a href="{{ n.url | rel }}"><span class="gs-th">{{ pic(n.data.image, 480, '', true, n.data.image_pos or '50% 50%') }}</span><span class="gs-tx"><b>{{ n.data.title }}</b><small>{% if n.data.titles and n.data.titles.length %}{{ games[n.data.titles[0]].name }}{% else %}{{ kick(n) }}{% endif %} · {{ (n.data.updated_at or n.data.published_at) | shortDate }}</small></span></a></li>{% endif %}{% endfor %}</ul>
</div></div>
</section>
{% endfor %}
{% if gsmall.length %}
<section class="mc-sec gs" aria-labelledby="h-g-more">
<header class="hz-sh"><h2 id="h-g-more">More genres</h2><i aria-hidden="true">//</i><a class="hz-link" href="{{ '/news.html' | rel }}">All news {{ arr() }}</a></header>
<div class="gs-box nf"><div class="nf-in gs-more">{% for e in gsmall %}<div class="gs-col"><a class="gs-colh" href="{{ ('/genre/' + e.g.slug + '.html') | rel }}"><img src="{{ ('/assets/img/micons/' + e.g.slug + '.webp') | rel }}" alt="" width="34" height="34" loading="lazy"><b>{{ e.g.name }}</b>{{ arr() }}</a>{% for n in e.items | limit(3) %}<a class="gs-row" href="{{ n.url | rel }}">{{ n.data.title }}</a>{% endfor %}</div>{% endfor %}</div></div>
</section>
{% endif %}

{# Game spotlights: the two most-covered games #}
{% for r in rank | limit(2) %}{% set sp = all | soloByGame(r.slug) %}
<section class="mc-sec" aria-labelledby="h-sp-{{ r.slug }}">
<header class="hz-sh"><h2 id="h-sp-{{ r.slug }}">{{ games[r.slug].name }}</h2><i aria-hidden="true">//</i><a class="hz-link" href="{{ ('/games/' + r.slug + '.html') | rel }}">All {{ games[r.slug].name }} {{ arr() }}</a></header>
<div class="hz-cards mc-n{{ 4 if sp.length > 4 else sp.length }}">{% for n in sp | limit(4) %}{{ card(n) }}{% endfor %}</div>
</section>
{% endfor %}

<script>
(function(){
var h=document.getElementById('gzHero');
if(h){var s=h.querySelectorAll('.hz-slide'),d=h.querySelectorAll('.hz-ctl button'),c=document.getElementById('gzCount'),i=0,tm;
function go(n){s[i].classList.remove('on');d[i].classList.remove('on');i=(n+s.length)%s.length;s[i].classList.add('on');d[i].classList.add('on');if(c)c.textContent='0'+(i+1)+' / 0'+s.length;}
function auto(){clearInterval(tm);if(!matchMedia('(prefers-reduced-motion: reduce)').matches)tm=setInterval(function(){go(i+1)},7000);}
d.forEach(function(b,k){b.addEventListener('click',function(){go(k);auto()})});
document.getElementById('gzPrev').addEventListener('click',function(){go(i-1);auto()});
document.getElementById('gzNext').addEventListener('click',function(){go(i+1);auto()});
h.addEventListener('mouseenter',function(){clearInterval(tm)});h.addEventListener('mouseleave',auto);h.addEventListener('focusin',function(){clearInterval(tm)});auto();}
var now=Date.now();document.querySelectorAll('.hz-ago time').forEach(function(t){var m=(now-new Date(t.getAttribute('datetime')))/6e4;if(m<0||isNaN(m)||m>=10080)return;t.textContent=m<60?Math.max(1,Math.round(m))+' min ago':m<1440?Math.round(m/60)+' h ago':Math.round(m/1440)+(Math.round(m/1440)===1?' day ago':' days ago');});
var tabs=document.querySelectorAll('.hz-tabs button'),al=[].slice.call(document.querySelectorAll('#gzAll li')),mb=document.getElementById('gzMoreB'),ac=document.getElementById('gzAllC'),flt='all',vis=6;
function paint(){var n=0,tot=0;al.forEach(function(li){var ok=flt==='all'||li.dataset.s===flt;if(ok)tot++;li.hidden=!(ok&&n<vis);if(ok&&n<vis)n++;});if(ac)ac.textContent=n+' / '+tot+' stories';if(mb)mb.hidden=n>=tot;}
tabs.forEach(function(b){b.addEventListener('click',function(){tabs.forEach(function(x){x.classList.toggle('on',x===b)});flt=b.dataset.f;vis=6;paint()})});
if(mb)mb.addEventListener('click',function(){vis+=6;paint()});paint();
})();
</script>
