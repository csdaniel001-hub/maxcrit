---
layout: base.njk
pagination: { data: hubTypes, size: 1, alias: h }
permalink: "/hub/{{ h.slug }}.html"
activeSection: hub
eleventyComputed:
  title: "Mobile game {{ h.name | lower }}"
  summary: "{{ h.desc }}"
  activeNav: "h-{{ h.slug }}"
  noindex: "{{ '' if (collections.hub | byHubType(h.slug)).length else 'yes' }}"
  shareImage: "{{ (collections.hub | byHubType(h.slug) | featured | first).data.image if (collections.hub | byHubType(h.slug) | featured).length else '' }}"
---
{% from "macros.njk" import listing with context %}
{% set tabs %}<nav class="gz-ptabs" aria-label="Player Hub"><a href="{{ '/hub.html' | rel }}">All hub pages</a>{% for x in hubTypes %}{% if (collections.hub | byHubType(x.slug)).length %}<a class="{% if x.slug == h.slug %}on{% endif %}" href="{{ ('/hub/' + x.slug + '.html') | rel }}">{{ x.name }}</a>{% endif %}{% endfor %}</nav><script>/*mcTabsScroll*/(function(){var n=document.currentScript.previousElementSibling,a=n&&n.querySelector(".on");if(a&&a.offsetLeft+a.offsetWidth>n.clientWidth)n.scrollLeft=a.offsetLeft-12})()</script>{% endset %}
{% if h.slug == 'builds' %}{% from "builds-dir.njk" import buildDir with context %}{% set items = collections.hub | byHubType('builds') %}
{% call buildDir(items, h.name, h.intro or h.desc, '<a href="' + ('/index.html' | rel) + '">Home</a> / <a href="' + ('/hub.html' | rel) + '">Player Hub</a> / Character builds') %}{{ tabs | safe }}{% endcall %}
{% if items.length %}<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Player Hub","item":"{{ site.url }}/hub.html"},{"@type":"ListItem","position":3,"name":"Character builds","item":"{{ site.url }}/hub/builds.html"}]},{"@type":"CollectionPage","url":"{{ site.url }}/hub/builds.html","name":"Character builds","mainEntity":{"@type":"ItemList","numberOfItems":{{ items.length }},"itemListElement":[{% for n in items | byCharacter %}{"@type":"ListItem","position":{{ loop.index }},"url":"{{ site.url }}{{ n.url }}","name":{{ n.data.title | unent | jsonify | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]}}]}</script>{% endif %}
{% else %}{{ listing(collections.hub | byHubType(h.slug), pre, 'Player Hub', h.name, h.desc, 'Pages', tabs, '') }}{% endif %}
