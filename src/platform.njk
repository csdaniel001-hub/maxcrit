---
layout: base.njk
pagination: { data: platformNav, size: 1, alias: p }
permalink: "/platform/{{ p.slug }}.html"
eleventyComputed:
  title: "{{ p.name }} game news, patches and guides"
  summary: "{{ p.desc }}"
  noindex: "{{ '' if (collections.stories | byPlatform(p.slug)).length else 'yes' }}"
  shareImage: "{{ (collections.stories | byPlatform(p.slug) | featured | first).data.image if (collections.stories | byPlatform(p.slug) | featured).length else '' }}"
---
{% from "macros.njk" import listing with context %}
{% set tabs = "" %}
{{ listing(collections.stories | byPlatform(p.slug), pre, 'Platform', p.name, p.desc, 'Pages', tabs, '') }}
